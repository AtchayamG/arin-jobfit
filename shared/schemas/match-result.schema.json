{
  "additionalProperties": false,
  "properties": {
    "band": {
      "enum": [
        "strong",
        "moderate",
        "weak"
      ],
      "maxLength": 8,
      "type": "string"
    },
    "blockers": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "dimensions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "maxLength": 500,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "gaps": {
            "items": {
              "maxLength": 500,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "name": {
            "enum": [
              "must_have_skills",
              "experience",
              "preferred_skills",
              "seniority",
              "location_remote",
              "employment_type",
              "domain"
            ],
            "maxLength": 16,
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "matched",
              "partial",
              "missing",
              "unknown"
            ],
            "maxLength": 7,
            "type": "string"
          },
          "weight": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "name",
          "weight",
          "score",
          "status",
          "evidence",
          "gaps"
        ],
        "type": "object"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "disclaimer": {
      "const": "Decision support only; not a prediction of hiring outcome.",
      "type": "string"
    },
    "fit_score": {
      "maximum": 1,
      "minimum": 0,
      "multipleOf": 0.01,
      "type": "number"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "profile_ref": {
      "anyOf": [
        {
          "pattern": "^prof_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "const": "inline",
          "type": "string"
        }
      ]
    },
    "scoring_version": {
      "const": "fit-v1",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "profile_ref",
    "scoring_version",
    "fit_score",
    "band",
    "confidence",
    "dimensions",
    "blockers",
    "disclaimer"
  ],
  "type": "object"
}
