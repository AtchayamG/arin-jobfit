{
  "name": "arin-jobfit-id",
  "version": "0.1.0",
  "description": "Arin JobFit (Indeed edition) — local, privacy-first MCP server for job-description analysis. Independent; not affiliated with Indeed.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "arin-jobfit-id": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<OWNER>/arin-jobfit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "job-search",
    "resume",
    "ai-agents",
    "claude",
    "codex"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint src tests && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "policy:lint": "tsx ../shared/job-core/scripts/policy-lint.ts config/policy.json ../Docs/09_DECISIONS_LOG.md",
    "verify": "npm run lint && npm run typecheck && npm run policy:lint && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
